APP_NAME="AVENIR MEDICAL"

# ---- Pendant le developpement (sur votre ordinateur) ----
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ---- Une fois le site en ligne, remplacez par : ----
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://avenir-medic.com

APP_KEY=
APP_TIMEZONE=Africa/Dakar

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Base de donnees (MySQL / MariaDB) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avenir_medical
DB_USERNAME=root
DB_PASSWORD=

TRANSLATE_DRIVER=deepl
TRANSLATE_KEY=2218ec99-7984-410c-a315-93e496180bb7:fx

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ---- Envoi des emails ----
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@avenir-medic.com"
MAIL_FROM_NAME="${APP_NAME}"
