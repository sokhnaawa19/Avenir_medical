APP_NAME="AVENIR MEDICAL"

# ---- Site en ligne ----
# APP_DEBUG=true affiche le code source et les mots de passe en cas d'erreur :
# il doit rester à false sur le serveur.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://avenir-medic.com

# Générez la clé une seule fois sur le serveur :  php artisan key:generate
APP_KEY=
APP_TIMEZONE=Africa/Dakar

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# En production, on ne journalise que les vraies erreurs.
LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- Base de données ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avenir_medical
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Les cookies ne circulent qu'en HTTPS.
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ---- Envoi des emails ----
# Renseignez le SMTP de votre hébergeur, sinon les confirmations de commande
# ne partiront pas (MAIL_MAILER=log les écrit seulement dans un fichier).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@avenir-medic.com"
MAIL_FROM_NAME="${APP_NAME}"
